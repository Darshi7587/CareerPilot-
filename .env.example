# LLM provider (gemini or groq)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Paths (relative to repo root, resolved automatically)
CAREERPILOT_SQLITE_PATH=careerpilot/backend/database/careerpilot.sqlite3
CAREERPILOT_CHROMA_PATH=careerpilot/backend/database/chroma
CAREERPILOT_CHECKPOINT_PATH=careerpilot/backend/memory/checkpoints.sqlite3
CAREERPILOT_UPLOAD_PATH=careerpilot/backend/database/uploads

# RAG settings
CAREERPILOT_RAG_CHUNK_SIZE=1000
CAREERPILOT_RAG_CHUNK_OVERLAP=150
CAREERPILOT_RAG_TOP_K=4
CAREERPILOT_MAX_UPLOAD_BYTES=10485760

# Conversation memory
CAREERPILOT_HISTORY_LIMIT=8

# Search
DUCKDUCKGO_MAX_RESULTS=5

# App
APP_NAME=CareerPilot AI
CAREERPILOT_BACKEND_URL=http://127.0.0.1:8000
